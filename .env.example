APP_ENV=prod
AWS_REGION=us-east-1

# DynamoDB (Lambda env must match your AWS table names)
PURCHASES_TABLE=course-platform-purchases
PURCHASES_HASH_KEY=user_id
PURCHASES_RANGE_KEY=course_id
COURSE_ACCESS_TABLE=course-platform-course-access
# Lesson progress: written to all three tables on mark complete / watch update
# - course-platform-course-access (user_id + course_id) — primary; created at checkout
# - course-platform-lesson-progress (user_id + sk = {course_id}#{lesson_id})
# - course-platform-purchases.completed_lesson_ids when a purchase row exists
PROGRESS_TABLE=course-platform-lesson-progress
USERS_TABLE=course-platform-users
COURSES_TABLE=course-platform-courses
LESSONS_TABLE=course-platform-lessons

# Vercel frontend — use /api proxy (see next.config.mjs rewrites) to avoid browser CORS
NEXT_PUBLIC_API_URL=/api

# Stripe checkout redirects + webhook
FRONTEND_URL=https://www.bestacademyofrealestate.com
NEXT_PUBLIC_SCHOOL_WEBSITE_URL=https://bestschoolofrealestate.biz
# Lead tracking (frontend / Vercel env vars). Defaults are built into
# components/tracking-scripts.tsx; set a var only to override (empty = disable).
# GA4: Admin > Data streams > Web > Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5QN8C82W42
# Meta Pixel: Events Manager > Data sources > your Pixel > ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=973497453037443
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Amazon SES)
# Send from your own domain (verified in SES with DKIM), never from @gmail.com:
# Gmail/Yahoo/Outlook spam-folder or reject mail "from" gmail.com sent via Amazon.
# Replies to quiz results go to the first QUESTIONNAIRE_LEAD_EMAIL address.
EMAIL_ENABLED=true
EMAIL_FROM=Bruce Parker Team <results@bestacademyofrealestate.com>
SUPPORT_EMAIL=bruceparkerteam@gmail.com

# Readiness quiz + purchase emails use app/services/email_templates.py for wording.
SCHOOL_WEBSITE_URL=https://bestschoolofrealestate.biz
# Staff notified on each quiz completion, comma-separated (each must be verified in SES while in sandbox)
QUESTIONNAIRE_LEAD_EMAIL=bruceparkerteam@gmail.com,btestrealtyhp@gmail.com
# true = email results to the quiz taker AND staff on submit (needs SES production access).
# false = staff only.
QUESTIONNAIRE_SEND_USER_EMAIL=true
QUESTIONNAIRE_QUESTIONS_TABLE=course-platform-questionnaire-questions
QUESTIONNAIRE_SUBMISSIONS_TABLE=course-platform-questionnaire-submissions

# Cognito — Lambda must match NEXT_PUBLIC_* on Vercel
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# Must match Cognito app client callback URL (your Vercel site, not API Gateway)
COGNITO_REDIRECT_URI=https://www.bestacademyofrealestate.com/auth/callback
VIDEO_BUCKET=
CLOUDFRONT_DOMAIN=
